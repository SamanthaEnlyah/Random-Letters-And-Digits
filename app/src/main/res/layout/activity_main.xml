            <EditText
                android:id="@+id/editTextYourSolution"
                android:layout_width="253dp"
                android:layout_height="44dp"
                android:layout_marginStart="30dp"
                android:layout_marginTop="10dp"
                android:ems="10"
                android:fontFamily="serif"
                android:hint="Your answer"
                android:inputType="text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewPlayedSoundInText" />

            <TextView
                android:id="@+id/textViewCheck"
                android:layout_width="253dp"
                android:layout_height="56dp"
                android:layout_marginStart="30dp"
                android:layout_marginTop="10dp"
                android:fontFamily="serif"
                android:text=""
                android:textSize="24sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/buttonCheck" />

            <TextView
                android:id="@+id/textViewSolution2"
                android:layout_width="257dp"
                android:layout_height="99dp"
                android:layout_marginStart="30dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/design_default_color_primary_variant"
                android:backgroundTint="@color/dark_blue"
                android:fontFamily="serif"
                android:padding="20dp"
                android:text="Solution"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="24sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewCheck" />

            <Button
                android:id="@+id/buttonReadFromDatabase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:onClick="ReadAnswers"
                android:text="Read answers from database"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/idGridViewAnswers" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="10dp"
                android:orientation="horizontal"
                tools:layout_editor_absoluteX="5dp">

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ID" />

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Problem" />

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Your Solution" />

                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Solution" />

                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Is it correct?" />
            </LinearLayout>

            <GridView
                android:id="@+id/idGridViewAnswers"
                android:layout_width="match_parent"
                android:layout_height="327dp"
                android:horizontalSpacing="6dp"
                android:numColumns="1"
                android:stretchMode="columnWidth"
                android:verticalSpacing="6dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewAnswerID">

            </GridView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="16dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textViewAnswerID"
                    android:layout_width="22dp"
                    android:layout_height="30dp"
                    android:text="ID"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textViewCheck" />

                <TextView
                    android:id="@+id/textViewSound"
                    android:layout_width="56dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="40dp"
                    android:fontFamily="serif"
                    android:text="Sound" />

                <TextView
                    android:id="@+id/textViewYourSolution"
                    android:layout_width="96dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="15dp"
                    android:fontFamily="serif"
                    android:text="Your solution" />

                <TextView
                    android:id="@+id/textViewSolution"
                    android:layout_width="58dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="10dp"
                    android:fontFamily="serif"
                    android:text="Solution" />

                <TextView
                    android:id="@+id/textViewIsCorrect"
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:fontFamily="serif"
                    android:text="Correct/Wrong"
                    app:layout_constraintStart_toEndOf="@+id/textViewSolution"
                    app:layout_constraintTop_toBottomOf="@+id/buttonCheckSolutionForUserProblem" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

