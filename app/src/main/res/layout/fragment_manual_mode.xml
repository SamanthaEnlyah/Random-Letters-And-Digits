<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="274dp"
        android:layout_height="352dp"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="60dp"
        android:background="@android:color/transparent"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent">


        <LinearLayout
            android:layout_width="273dp"
            android:layout_height="350dp"
            android:background="@drawable/gradient_blue"
            android:orientation="vertical"
            tools:context=".ManualModeFragment">


            <TextView
                android:id="@+id/textView2"
                android:layout_width="230dp"
                android:layout_height="53dp"
                android:layout_marginStart="30dp"
                android:layout_marginTop="28dp"
                android:fontFamily="serif"
                android:onClick="ToggleProblems"
                android:text="Manually type a problem for app to solve:"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:layout_constraintStart_toEndOf="@+id/textView"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/editTextProblem"
                android:layout_width="210dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="4dp"
                android:ems="10"
                android:fontFamily="serif"
                android:hint="Type problem"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:textColorHint="#FFFFFF"
                android:textSize="16sp"
                app:layout_constraintStart_toEndOf="@+id/textViewLengthLabel"
                app:layout_constraintTop_toBottomOf="@+id/textView2" />

            <Button
                android:id="@+id/buttonCheck2"
                android:layout_width="215dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#1B62DD"
                android:fontFamily="serif"
                android:onClick="SolveMyProblem"
                android:text="Solve"
                app:layout_constraintStart_toEndOf="@+id/editTextNumberSoundLength"
                app:layout_constraintTop_toBottomOf="@+id/editTextProblem" />

            <Button
                android:id="@+id/buttonCheckSolutionForUserProblem"
                android:layout_width="222dp"
                android:layout_height="113dp"
                android:layout_marginStart="30dp"
                android:layout_marginTop="26dp"
                android:backgroundTint="#1B62DD"
                android:onClick="CheckSolutionForUserProblem"
                android:text="Check Your solution for manually entered problem"
                app:layout_constraintStart_toEndOf="@+id/buttonCheck"
                app:layout_constraintTop_toBottomOf="@+id/editTextYourSolution" />


        </LinearLayout>
    </androidx.cardview.widget.CardView>

    </LinearLayout>